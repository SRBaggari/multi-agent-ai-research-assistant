# ==================================================
# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.
# ==================================================

# ----- OpenAI -----
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Must be a model your key can actually use (e.g. gpt-4o-mini, gpt-4o).
OPENAI_MODEL=gpt-4o-mini

# Optional. Leave blank to use OpenAI itself.
# Set it to any OpenAI-compatible endpoint to use another provider with
# the same SDK, and set OPENAI_MODEL to one of that provider's models:
#   Groq       -> https://api.groq.com/openai/v1
#   OpenRouter -> https://openrouter.ai/api/v1
#   Ollama     -> http://localhost:11434/v1   (fully offline, no key needed;
#                 put any placeholder in OPENAI_API_KEY, e.g. "ollama")
OPENAI_BASE_URL=

# ----- MongoDB -----
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=research_assistant

# ----- Authentication -----
# Any long random string. Change this for your own project.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=1

# ----- Storage -----
# Relative paths are resolved from the project root, not the terminal.
VECTOR_STORE_PATH=../vector_store

# ----- RAG -----
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ----- Supervisor -----
# true = ask the LLM to classify requests that match no keyword.
USE_LLM_ROUTER=false
